#!/bin/sh
# pre-push hook: only karthi-ai-engineer pushes, and only karthi-ai-engineer commits leave this machine.
# Activate once per clone:  git config core.hooksPath .githooks

remote_url="$2"
expected="296384397+karthi-ai-engineer@users.noreply.github.com"
zero=0000000000000000000000000000000000000000

case "$remote_url" in
  https://karthi-ai-engineer@github.com/karthi-ai-engineer/*) ;;
  *)
    echo "ERROR (pre-push): remote must be https://karthi-ai-engineer@github.com/karthi-ai-engineer/<repo>.git" >&2
    echo "so the karthi-ai-engineer credentials are used (got: $remote_url)." >&2
    exit 1
    ;;
esac

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi

  bad=$(git log --format='%h %ae %ce' "$range" | awk -v e="$expected" '$2 != e || $3 != e { print $1 }')
  if [ -n "$bad" ]; then
    echo "ERROR (pre-push): these commits are not authored/committed as karthi-ai-engineer:" >&2
    echo "$bad" >&2
    exit 1
  fi

  if git log --format='%B' "$range" | grep -qiE '^co-authored-by:|generated with|anthropic|claude code|claude-session'; then
    echo "ERROR (pre-push): a commit message contains a co-author / 'generated with' / assistant attribution line." >&2
    exit 1
  fi
done

exit 0
