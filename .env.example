# Copy to .env and fill in. Never commit .env.
AI_VERSION=O                 # O = OpenAI, B = AWS Bedrock
OPENAI_API_KEY=              # company account key
AWS_REGION=ap-northeast-1    # used by Version B (Gate 0b)
DATABASE_URL=postgresql://myrobots:myrobots@localhost:5432/myrobots
STORAGE_BACKEND=local        # local | s3
STORAGE_PATH=./data
